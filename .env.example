# ===== 短剧工坊 环境变量示例（复制为 .env 后填入真实值）=====
# .env 已在 .gitignore 中，绝不入库。
# 代码会优先读环境变量，环境变量缺失时才回退到项目根 .env。

# SenseNova AI 文案（webapp/ai_copy_generator.py）
# 留空则 AICopyGenerator.enabled=False，文案直接走模板兜底，不做任何 API 调用。
SENSENOVA_API_KEY=
SENSENOVA_API_BASE=https://token.sensenova.cn/v1
SENSENOVA_MODEL=sensenova-6.8-flash-lite

# ⚠️ 关于密钥轮换
# 旧 key 已随 init 提交 eb2290a 进入本公开仓库的 git 历史，等于全网泄露。
# 必须：① 到 SenseNova 后台吊销旧 key  ② 用新 key 填到 .env
# 仅把 key 移出源码并不能消除历史泄露 —— 历史里仍可取出。
